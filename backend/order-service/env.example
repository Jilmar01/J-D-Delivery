# Copiar a .env (el .env no se sube a Git)
DATABASE_URL="postgresql://postgres:tu_clave@localhost:5432/delivery_order_db?schema=public"
PORT=3001

# Servidor TCP de concurrencia (concurrency-tcp-service): IP de la PC que lo ejecuta
TCP_HOST=localhost
TCP_PORT=12345

# Punto de salida (el local): con él se elige al repartidor más cercano
PICKUP_LAT=-0.180653
PICKUP_LNG=-78.467834
