# Definir estas variables en el sistema antes de iniciar (el servicio no carga archivos .env)
TCP_PORT=12345
DATABASE_URL="postgresql://postgres:tu_clave@localhost:5432/delivery_order_db"
# Solo para los clientes (enviar, concurrencia): IP de la PC que ejecuta el servidor TCP
TCP_HOST=localhost
# Opcionales, solo si cambian los nombres en la base (por defecto: Pedido / repartidorId / updatedAt)
# PEDIDOS_TABLE=Pedido
# PEDIDOS_COL_REPARTIDOR=repartidorId
# PEDIDOS_COL_ACTUALIZADO=updatedAt
