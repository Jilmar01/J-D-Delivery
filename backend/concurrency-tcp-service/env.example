# Definir estas variables en el sistema antes de iniciar (el servicio no carga archivos .env)
TCP_PORT=12345
# Base de delivery-service (tablas deliveries y delivery_history)
DATABASE_URL="postgresql://postgres:tu_clave@localhost:5432/delivery_delivery_db"
# Solo para los clientes (enviar, concurrencia, repartidor): IP de la PC que ejecuta el servidor TCP
TCP_HOST=localhost
