generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  CLIENTE
  ADMIN
}

model Usuario {
  id              Int      @id @default(autoincrement())
  usuario         String
  correo          String   @unique
  password        String
  rol             Rol      @default(CLIENTE)
  createdAt       DateTime @default(now())
}